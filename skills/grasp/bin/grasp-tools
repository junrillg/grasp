#!/usr/bin/env bash
# grasp-tools: the exact, mechanical steps of the grasp skill.
# Needs only bash, sed, awk, git and curl. Run `grasp-tools -h` for usage.
set -u
# Bytes, not characters: BSD awk and sed stop on a byte that is not valid UTF-8, which would hide
# a block that is already in the file. CDPATH would send a relative cd somewhere else.
export LC_ALL=C
unset CDPATH

# Resolve this script's real location (following symlinks) to find the skill directory.
_src=${BASH_SOURCE[0]}
while [[ -L "$_src" ]]; do
  _dir=$(cd -P "$(dirname "$_src")" && pwd)
  _src=$(readlink "$_src")
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
GRASP_HOME=$(cd -P "$(dirname "$_src")/.." && pwd)

BLOCK_FORMAT=1
TOGGLE_FORM=html   # set by the Obsidian render test (docs/research/visual-pages.md)
STEPS="work verify review resolve record import"   # record, import: blocks in AGENTS.md / CLAUDE.md
RUNS_DEFAULT=docs/how-it-works/runs

usage() {
  cat <<'EOF'
grasp-tools: exact steps for the grasp skill

Usage: grasp-tools [--config PATH] <command> [args]

Commands:
  connect SKILL_DIR STEP   add or replace grasp's block in SKILL_DIR/SKILL.md and list it in
                           .grasp.md. STEP is one of: work, verify, review, resolve
  connect FILE record      the same for an agent instructions file (AGENTS.md, CLAUDE.md): the
                           block tells every agent run to leave a run record. Creates FILE
                           when it is missing
  connect CLAUDE.md import make CLAUDE.md load AGENTS.md (one line, @AGENTS.md, in a marked
                           block). Needed when the project has a CLAUDE.md: Claude Code
                           then stops reading AGENTS.md by itself
  disconnect TARGET        remove the block and its row (TARGET: a SKILL_DIR or a FILE)
  block STEP               print the block connect would write, to show before writing it
  status                   list what is connected: TARGET, STEP, ok|stale|no-block|missing|broken
  refresh [TARGET]         rewrite stale or missing blocks (everything connected by default)
  record-index [DIR]       rebuild DIR/README.md, the table of run records, newest first
                           (DIR defaults to "run records:" in .grasp.md)
  record-check [--base REF] [--hook]
                           exit 1 when files changed and no run record was written. Looks at
                           uncommitted changes plus commits since REF (default: where this
                           branch left the integration branch, else the upstream)
                           --hook: for an agent's Stop hook. Reads the hook's JSON on stdin,
                           blocks once with exit 2 and the reason on stderr, never loops
  projects [DIR]           list sub-projects under DIR (default .): PATH, repo|package, markers,
                           and a repository's origin remote when it has one. A repository is
                           found up to eight folders deep, a package up to three
  check-link URL           check a learning link live. Prints "ok" and, after a tab each: a
                           YouTube video's title and channel; a LinkedIn Learning course's
                           final URL and title; any other page's final URL. A link that
                           fails prints "fail REASON" and exits 1
  lint-page FILE...        check a page renders in Obsidian and on GitHub: toggles, links to
                           files that are missing, diagram type and quotes, prose wrapped
                           by hand, and that git does not ignore the page. Also reports
                           too-many-boxes (a diagram with more than 20 boxes) and, by the
                           kind of page read from its content: too-long (the words a reader
                           sees, toggles and code not counted: run record 150, issue page
                           400, feature page 350, architecture page 900, app map and
                           workspace map 1100), no-concepts (an issue page, app map,
                           architecture or feature page with no "## Concepts" heading),
                           no-lessons (an architecture page whose "## Lessons" holds no
                           YouTube or LinkedIn Learning link and no "No checked lesson
                           yet"), no-answer (a built or verified issue
                           page with an empty "Your answer:"). Exits 1 when anything is
                           reported
  change-map [--repo DIR]... [--base REF] [--head REF] [--depth N]
                           print a Mermaid block, ready to paste, that shows the code base as
                           a few boxes coloured by what the change did: green new, amber
                           changed, grey one box per repository for the folders left alone.
                           Each --repo (default .) is one subgraph. A box is a folder cut to
                           N segments (default 2), cut further while there are more than 18
                           boxes. Changed means commits since BASE, uncommitted and untracked
                           files; with --head REF only the commits in BASE...REF. BASE (default: origin/HEAD, origin/develop, origin/main,
                           develop, main, master, the first that exists) is resolved in
                           each repository, and so is REF
  snippet [--repo DIR] [--rev REV] FILE START END
                           print lines START..END of FILE as committed at REV (default HEAD,
                           never the working tree) as a marker line, a fence and, when origin
                           is on GitHub or GitLab, a permalink. Paste it onto a page as is.
                           FILE is relative to the repository root. Exits 1 on a missing file,
                           an unknown REV or a range past the end
  snippet-check [--repo DIR]... PAGE
                           check that every fence under a snippet marker still equals the code
                           at its commit. Reports snippet-drift (the fence was edited),
                           snippet-unreachable (the commit is not in the repository),
                           snippet-unknown-repo (no --repo has that folder name; default .)
                           and, on a page named *-code.md, snippet-unmarked (a fence that is
                           not a diagram and has no marker above it). Exits 1 when anything
                           is reported
  coverage [--repo DIR]... [--base REF] [--head REF] PAGE...
                           prove that the pages name every file changed in each repository
                           (default .) since the merge base of BASE and HEAD. With --head, the
                           commits up to it; with --base alone, the working tree too (staged,
                           unstaged and untracked). Without --base, each repository's range is
                           read from the "Checked against:" line of the first PAGE. A file is named when a page holds it in
                           backticks or <code> as path, REPO/path, or under a "folder/**".
                           Prints MISSING REPO/path for each file no page names, STALE path for
                           a path in the first column of a table that is neither changed nor in
                           any repository, then "N of M changed files named". Exits 1 on any
                           MISSING or STALE, 2 on bad use, a git error or no range to read
  version                  print the grasp version

Options:
  --config PATH            the project's .grasp.md (default: ./.grasp.md); every SKILL_DIR,
                           FILE and the run records folder are relative to its folder
  -h, --help, help         show this help
EOF
}

die() { printf 'grasp-tools: %s\n' "$2" >&2; exit "$1"; }

cmd_version() { tr -d '[:space:]' < "$GRASP_HOME/VERSION"; printf '\n'; }

# ---------- connect / disconnect / status / refresh ----------

cfg_dir() { cd "$(dirname "$CONFIG")" && pwd; }

valid_step() { case " $STEPS " in *" $1 "*) return 0 ;; esac; return 1; }

# eol_of FILE -> prints "crlf" or "lf" from the first line ending
eol_of() {
  if [[ -s "$1" ]] && head -n 1 "$1" | od -An -c | tr -d ' \n' | grep -q '\\r\\n$'; then
    echo crlf
  else
    echo lf
  fi
}

ends_with_newline() { [[ ! -s "$1" ]] || [[ "$(tail -c 1 "$1" | od -An -c | tr -d ' ')" == '\n' ]]; }

# runs_dir -> the run records folder: "- run records:" in .grasp.md, relative to its folder
runs_dir() {
  local d=''
  [[ -f "$CONFIG" ]] && d=$(sed -n 's/^- run records:[[:space:]]*//p' "$CONFIG" | head -n 1 | tr -d '\r')
  d=${d%"${d##*[![:space:]]}"}   # trailing spaces
  while [[ "$d" == */ ]]; do d=${d%/}; done
  printf '%s' "${d:-$RUNS_DEFAULT}"
}

# record_block_text EOL_CHARS -> the block for AGENTS.md / CLAUDE.md. It loads into every agent
# session, so it stays short: direct commands, five fixed fields, nothing else.
record_block_text() {
  local e=$1 v d shared=()
  v=$(cmd_version); d=$(runs_dir)
  # a folder outside this repository is a workspace's shared one: records name their project
  if [[ "$d" == ../* || "$d" == /* ]]; then
    shared=("That folder is shared by several projects: start the short name with \`$(basename "$(cfg_dir)")-\`." "$e")
  fi
  printf '%s%s' \
    "<!-- grasp:start b=$BLOCK_FORMAT v=$v step=record dir=$d -->" "$e" \
    "## Run records (grasp)" "$e" \
    "Before your final message on any task that changed files in this project, write one run record:" "$e" \
    "\`$d/YYYY-MM-DD-short-name.md\`. It is part of the task, also when you were told to change only" "$e" \
    "certain files. One file per task; the same task continued updates its file." "$e" \
    ${shared[@]+"${shared[@]}"} \
    "Start it with \`# YYYY-MM-DD: short name\` and \`Status: done\` (or \`partial\`, \`blocked\`, \`failed\`), then" "$e" \
    "exactly these five lines, one short plain sentence each:" "$e" \
    "- **Asked:** the request." "$e" \
    "- **Changed:** what behaves differently now." "$e" \
    "- **Checked:** the command you ran and its result line, or \"not checked\"." "$e" \
    "- **Problems:** what failed, was worked around or is uncertain, or \"none\"." "$e" \
    "- **Next:** what a person should do or decide next, or \"nothing\"." "$e" \
    "Under them, when the change has a shape (steps, or parts that connect), add one small Mermaid" "$e" \
    "\`flowchart\` of it: at most 10 boxes, every label in double quotes." "$e" \
    "Write only what happened: never claim a change or a check you did not make. No secrets, tokens," "$e" \
    "env values or raw command output. Skip it for questions and for runs that changed no files." "$e" \
    "With the grasp skill installed, \`/grasp record\` writes it and rebuilds the index." "$e" \
    "<!-- grasp:end -->" "$e"
}

# block_text STEP EOL_CHARS -> the exact block
block_text() {
  local step=$1 e=$2 v
  [[ $step == record ]] && { record_block_text "$e"; return; }
  if [[ $step == import ]]; then
    printf '%s%s' "<!-- grasp:start b=$BLOCK_FORMAT v=$(cmd_version) step=import -->" "$e" "@AGENTS.md" "$e" "<!-- grasp:end -->" "$e"
    return
  fi
  v=$(cmd_version)
  printf '%s%s' \
    "<!-- grasp:start b=$BLOCK_FORMAT v=$v step=$step -->" "$e" \
    "## Learning page (grasp)" "$e" \
    "When this skill has finished its own work, run grasp's \`page\` subcommand for the same issue or" "$e" \
    "pull request with \`--step $step\` (\`/grasp page <issue or PR> --step $step\`, or \`/grasp:grasp page ...\`" "$e" \
    "when grasp is installed as a plugin), so the issue's learning page shows what was done." "$e" \
    "Skip this if grasp is not installed." "$e" \
    "<!-- grasp:end -->" "$e"
}

# locate_block FILE -> "START END" line numbers of grasp's block, ignoring fenced code.
# Uses the last start marker outside a fence; END is 0 when that start has no end marker.
# Prints nothing when there is no block.
locate_block() {
  awk '
    { line = $0; sub(/\r$/, "", line); t = line; sub(/^[ ]{0,3}/, "", t) }
    fence != "" {
      if (index(t, fence) == 1 && t ~ /^(`+|~+)[ \t]*$/) { fence = ""; hid = 0 }
      else if (line ~ /^<!-- grasp:start /) hid = NR
      next
    }
    t ~ /^```/ || t ~ /^~~~/ { match(t, /^(`+|~+)/); fence = substr(t, 1, RLENGTH); next }
    line ~ /^<!-- grasp:start / { s = NR; e = 0; next }
    s && !e && line ~ /^<!-- grasp:end -->[ \t]*$/ { e = NR }
    # a code fence still open at the end of the file hides a marker: report it as broken (END 0)
    # so nothing appends a second block under it
    END { if (fence != "" && hid) print hid, 0; else if (s) print s, e }
  ' "$1"
}

has_block() { [[ -n "$(locate_block "$1")" ]]; }

# block_broken FILE: a start marker with no end marker after it
block_broken() { local loc; loc=$(locate_block "$1"); [[ -n "$loc" && "${loc#* }" == 0 ]]; }

# write_if_changed NEW TARGET: replace TARGET only when bytes differ (keeps mtime otherwise)
write_if_changed() {
  [[ -n "$1" && -f "$1" ]] || die 1 "temporary file missing; $2 was left as it was"
  if cmp -s "$1" "$2"; then rm -f "$1"; return 0; fi
  if ! cat "$1" > "$2"; then rm -f "$1"; die 1 "cannot write $2"; fi
  rm -f "$1"
}

# put_block FILE STEP: append the block, or replace the existing one in place
put_block() {
  local f=$1 step=$2 e tmp blk
  e=$'\n'; [[ $(eol_of "$f") == crlf ]] && e=$'\r\n'
  tmp=$(mktemp "${TMPDIR:-/tmp}/grasp.XXXXXX") || die 1 "cannot create a temporary file in ${TMPDIR:-/tmp}; nothing was changed"
  blk=$(mktemp "${TMPDIR:-/tmp}/grasp.XXXXXX") || die 1 "cannot create a temporary file in ${TMPDIR:-/tmp}; nothing was changed"
  block_text "$step" "$e" > "$blk"
  local loc; loc=$(locate_block "$f")
  if [[ -n "$loc" ]]; then
    awk -v blk="$blk" -v s="${loc% *}" -v e="${loc#* }" '
      NR == s { while ((getline l < blk) > 0) print l }
      NR >= s && NR <= e { next }
      { print }
    ' "$f" > "$tmp"
    # awk ends every line with \n; drop it if the original had no final newline
    if ! ends_with_newline "$f"; then
      local sz; sz=$(wc -c < "$tmp"); head -c $((sz - 1)) "$tmp" > "$tmp.2" && mv "$tmp.2" "$tmp"
    fi
  else
    cat "$f" > "$tmp"
    ends_with_newline "$f" || printf '%s' "$e" >> "$tmp"
    [[ -s "$f" ]] && printf '%s' "$e" >> "$tmp"
    cat "$blk" >> "$tmp"
  fi
  rm -f "$blk"
  write_if_changed "$tmp" "$f"
}

# drop_block FILE: remove the block and the one blank line before it
drop_block() {
  local f=$1 tmp
  local loc; loc=$(locate_block "$f")
  [[ -n "$loc" ]] || return 0
  tmp=$(mktemp "${TMPDIR:-/tmp}/grasp.XXXXXX") || die 1 "cannot create a temporary file in ${TMPDIR:-/tmp}; nothing was changed"
  awk -v s="${loc% *}" -v e="${loc#* }" '
    function flush() { if (held) { print prev; held = 0 } }
    NR == s { if (held && prev ~ /^\r?$/) held = 0; flush(); next }
    NR > s && NR <= e { next }
    { flush(); prev = $0; held = 1 }
    END { flush() }
  ' "$f" > "$tmp"
  write_if_changed "$tmp" "$f"
}

SECTION='## Connected skills'

# rows -> "skill<TAB>step" for each row of the Connected skills table
rows() {
  [[ -f "$CONFIG" ]] || return 0
  awk -v sec="$SECTION" '
    { sub(/\r$/, "") }
    /^## / { in_sec = ($0 == sec); next }
    in_sec && /^\|/ {
      n = split($0, c, "|"); if (n < 4) next
      sk = c[2]; st = c[3]; gsub(/^[ \t]+|[ \t]+$/, "", sk); gsub(/^[ \t]+|[ \t]+$/, "", st)
      if (sk == "skill" || sk ~ /^-+$/) next
      print sk "\t" st
    }
  ' "$CONFIG"
}

# upsert_row SKILL STEP (STEP empty = delete)
upsert_row() {
  local skill=$1 step=$2 v tmp
  v=$(cmd_version)
  [[ -f "$CONFIG" ]] || : > "$CONFIG"
  tmp=$(mktemp "${TMPDIR:-/tmp}/grasp.XXXXXX") || die 1 "cannot create a temporary file in ${TMPDIR:-/tmp}; nothing was changed"
  if ! grep -q "^$SECTION"$'\r\\{0,1\\}$' "$CONFIG"; then
    [[ -z "$step" ]] && { rm -f "$tmp"; return 0; }
    cat "$CONFIG" > "$tmp"
    ends_with_newline "$CONFIG" || printf '\n' >> "$tmp"
    [[ -s "$CONFIG" ]] && printf '\n' >> "$tmp"
    printf '%s\n\n| skill | step | grasp version |\n| ----- | ---- | ------------- |\n| %s | %s | %s |\n' \
      "$SECTION" "$skill" "$step" "$v" >> "$tmp"
  else
    local has_table
    has_table=$(awk -v sec="$SECTION" '
      { sub(/\r$/, "") } /^## / { in_sec = ($0 == sec); next } in_sec && /^\|/ { print 1; exit }' "$CONFIG")
    awk -v sec="$SECTION" -v sk="$skill" -v st="$step" -v ver="$v" -v has_table="${has_table:-0}" '
      function row() { return "| " sk " | " st " | " ver " |" }
      function emit_new() { if (st != "" && !written) { print row(); written = 1 } }
      {
        line = $0; sub(/\r$/, "", line)
        if (line == sec && !has_table && st != "") {
          print; print ""; print "| skill | step | grasp version |"; print "| ----- | ---- | ------------- |"
          emit_new(); in_sec = 1; next
        }
        if (line ~ /^## /) {
          if (in_sec && last_tbl && last_tbl == NR - 1) emit_new()
          in_sec = (line == sec)
        }
        if (in_sec && line ~ /^\|/) {
          n = split(line, c, "|"); k = c[2]; gsub(/^[ \t]+|[ \t]+$/, "", k)
          if (k == sk) { if (st != "" && !written) { print row(); written = 1 }; last_tbl = NR; next }
          print; last_tbl = NR; next
        }
        if (in_sec && last_tbl && last_tbl == NR - 1) emit_new()
        print
      }
      END { if (in_sec && last_tbl == NR) emit_new() }
    ' "$CONFIG" > "$tmp"
  fi
  write_if_changed "$tmp" "$CONFIG"
  if [[ -n "$step" ]] && ! rows | grep -qxF "$skill"$'\t'"$step"; then
    die 1 "could not record $skill in $CONFIG; add the row under '$SECTION' by hand"
  fi
}

# norm_dir PATH -> the skill folder or file relative to the config's folder ("./x/", "/abs/root/x" -> "x")
norm_dir() {
  local d=$1 root
  root=$(cd -P "$(dirname "$CONFIG")" && pwd)
  [[ "$d" == /* && -d "$d" ]] && d=$(cd -P "$d" && pwd)
  [[ "$d" == /* && -f "$d" ]] && d=$(cd -P "$(dirname "$d")" && pwd)/$(basename "$d")
  while [[ "$d" == */ ]]; do d=${d%/}; done
  [[ "$d" == "$root"/* ]] && d=${d#"$root"/}
  while [[ "$d" == ./* ]]; do d=${d#./}; done
  printf '%s' "$d"
}

# target_file TARGET STEP -> the file holding the block: TARGET itself for step record
# (AGENTS.md, CLAUDE.md), otherwise TARGET/SKILL.md
target_file() {
  if [[ $2 == record || $2 == import ]]; then printf '%s/%s' "$(cfg_dir)" "$1"; else printf '%s/%s/SKILL.md' "$(cfg_dir)" "$1"; fi
}

# step_of TARGET -> the step recorded for it in .grasp.md, or nothing
step_of() { rows | awk -F'\t' -v d="$1" '$1 == d { print $2; exit }'; }

# state TARGET STEP -> ok | stale | no-block | missing | broken
state_of() {
  local f b st
  f=$(target_file "$1" "$2")
  [[ -f "$f" ]] || { echo missing; return; }
  local loc; loc=$(locate_block "$f")
  [[ -n "$loc" ]] || { echo no-block; return; }
  [[ "${loc#* }" == 0 ]] && { echo broken; return; }
  local marker; marker=$(sed -n "${loc% *}p" "$f")
  b=$(printf '%s' "$marker" | sed -n 's/^<!-- grasp:start b=\([0-9]*\).*/\1/p')
  st=$(printf '%s' "$marker" | sed -n 's/^<!-- grasp:start .*step=\([a-z]*\).*/\1/p')
  if [[ -z "$b" || "$b" -lt "$BLOCK_FORMAT" || "$st" != "$2" ]]; then echo stale; return; fi
  if [[ $2 == record ]]; then   # the block names the run records folder: stale when that moved
    local d; d=$(printf '%s' "$marker" | sed -n 's/^<!-- grasp:start .* dir=\(.*\) -->.*$/\1/p')
    [[ "$d" == "$(runs_dir)" ]] || { echo stale; return; }
  fi
  # stale also when the text itself differs from what this grasp writes (a reworded block, a
  # hand edit). The version in the marker is left out: a release that keeps the wording must
  # leave every file untouched.
  local cur want
  cur=$(sed -n "${loc% *},${loc#* }p" "$f" | tr -d '\r' | sed '1s/ v=[^ ]*//')
  want=$(block_text "$2" $'\n' | sed '1s/ v=[^ ]*//')
  [[ "$cur" == "$want" ]] || { echo stale; return; }
  echo ok
}

cmd_connect() {
  [[ $# -eq 2 ]] || die 2 "usage: connect SKILL_DIR STEP | connect FILE record | connect CLAUDE.md import"
  local dir step=$2 f
  dir=$(norm_dir "$1")
  valid_step "$step" || die 2 "STEP must be one of: $STEPS"
  f=$(target_file "$dir" "$step")
  if [[ $step == record || $step == import ]]; then
    [[ -d "$f" ]] && die 1 "$dir is a folder; give the instructions file (AGENTS.md or CLAUDE.md)"
    [[ -f "$f" ]] || : > "$f" || die 1 "cannot create $dir"
  else
    [[ -f "$f" ]] || die 1 "no SKILL.md in $dir"
  fi
  block_broken "$f" && die 1 "${f#"$(cfg_dir)"/} has a grasp:start line with no grasp:end after it; fix it by hand first"
  put_block "$f" "$step"
  upsert_row "$dir" "$step"
  printf 'connected %s %s\n' "$dir" "$step"
}

cmd_block() {
  [[ $# -eq 1 ]] || die 2 "usage: block STEP"
  valid_step "$1" || die 2 "STEP must be one of: $STEPS"
  block_text "$1" $'\n'
}

cmd_disconnect() {
  [[ $# -eq 1 ]] || die 2 "usage: disconnect TARGET"
  local dir f
  dir=$(norm_dir "$1")
  rows | cut -f1 | grep -qxF "$dir" || die 1 "$dir is not connected (grasp-tools status lists what is)"
  f=$(target_file "$dir" "$(step_of "$dir")")
  if [[ -f "$f" ]]; then
    block_broken "$f" && die 1 "${f#"$(cfg_dir)"/} has a grasp:start line with no grasp:end after it; fix it by hand first"
    drop_block "$f"
  fi
  upsert_row "$dir" ""
  printf 'disconnected %s\n' "$dir"
}

cmd_status() {
  local skill step st bad=0
  while IFS=$'\t' read -r skill step; do
    st=$(state_of "$skill" "$step")
    printf '%s\t%s\t%s\n' "$skill" "$step" "$st"
    [[ $st == ok ]] || bad=1
  done < <(rows)
  return $bad
}

cmd_refresh() {
  local only='' skill step st bad=0
  [[ -n "${1:-}" ]] && only=$(norm_dir "$1")
  [[ -z "$only" || -n "$(step_of "$only")" ]] || die 1 "$only is not connected (grasp-tools status lists what is)"
  while IFS=$'\t' read -r skill step; do
    [[ -n "$only" && "$skill" != "$only" ]] && continue
    st=$(state_of "$skill" "$step")
    case $st in
      ok) ;;
      missing|broken) printf '%s %s\n' "$st" "$skill" >&2; bad=1 ;;
      *) put_block "$(target_file "$skill" "$step")" "$step"; upsert_row "$skill" "$step"; printf 'refreshed %s %s\n' "$skill" "$step" ;;
    esac
  done < <(rows)
  return $bad
}

# ---------- run records ----------

# cmd_record_index [DIR]: rebuild DIR/README.md from the records in DIR. The table is built, never
# hand-edited, so two branches that both add a record settle a conflict by running this again.
cmd_record_index() {
  [[ $# -le 1 ]] || die 2 "usage: record-index [DIR]"
  local dir=${1:-} f n=0 tmp
  if [[ -z "$dir" ]]; then
    dir=$(runs_dir); [[ "$dir" == /* ]] || dir="$(cfg_dir)/$dir"
    [[ -d "$dir" ]] && dir=$(cd "$dir" && pwd)
  fi
  [[ -d "$dir" ]] || die 1 "no such folder: $dir"
  tmp=$(mktemp "${TMPDIR:-/tmp}/grasp.XXXXXX") || die 1 "cannot create a temporary file in ${TMPDIR:-/tmp}; nothing was changed"
  cat > "$tmp" <<'EOF'
# Run records

What agents did here, newest first. One row per task; open it for the detail.

This table is built by `grasp-tools record-index`. Don't edit it by hand: run that again, also to settle a merge conflict here.

| Date | Task | Status | What changed | Problems |
| ---- | ---- | ------ | ------------ | -------- |
EOF
  while IFS= read -r f; do
    case "$f" in README.md|_*) continue ;; *.md) ;; *) continue ;; esac
    [[ -f "$dir/$f" ]] || continue
    n=$((n + 1))
    awk -v file="$f" '
      function cell(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); gsub(/\|/, "\\|", s); return s == "" ? "?" : s }
      function field(line, name,   re) {
        re = "^(- )?\\*\\*" name ":\\*\\*[ \t]*"
        if (line !~ re) return ""
        sub(re, "", line); return line
      }
      {
        line = $0; sub(/\r$/, "", line); t = line; sub(/^[ ]+/, "", t)
        if (fence != "") { if (index(t, fence) == 1) fence = ""; next }
        if (t ~ /^```/ || t ~ /^~~~/) { fence = substr(t, 1, 3); next }
        if (title == "" && line ~ /^# /) {
          title = substr(line, 3); sub(/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]:[ \t]*/, "", title)
        }
        if (status == "" && line ~ /^Status:[ \t]*/) { s = line; sub(/^Status:[ \t]*/, "", s); split(s, w, " "); status = w[1] }
        if (changed == "") changed = field(line, "Changed")
        if (problems == "") problems = field(line, "Problems")
      }
      END {
        date = (file ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/) ? substr(file, 1, 10) : "?"
        if (title == "") { title = file; sub(/\.md$/, "", title) }
        link = file; gsub(/ /, "%20", link); gsub(/\(/, "%28", link); gsub(/\)/, "%29", link)
        title = cell(title); gsub(/\[/, "\\[", title); gsub(/\]/, "\\]", title)
        printf "| %s | [%s](%s) | %s | %s | %s |\n", date, title, link, cell(status), cell(changed), cell(problems)
      }
    ' "$dir/$f" >> "$tmp"
  done < <(ls "$dir" | LC_ALL=C sort -r)
  write_if_changed "$tmp" "$dir/README.md"
  printf 'indexed %s %s/README.md\n' "$n" "$dir"
}

# record_state BASE -> one line, exit 1 when files changed and no run record was written.
# "Changed" is the uncommitted tree plus the commits since BASE; pages in the notebook folder
# (the parent of the run records folder) are not work that needs a record.
record_state() {
  local base=$1 cfg root runs absruns relruns='' relnb='' integ cur changed work n s
  cfg=$(cd -P "$(dirname "$CONFIG")" 2>/dev/null && pwd) || { echo "ok no-config-folder"; return 0; }
  root=$(git -C "$cfg" rev-parse --show-toplevel 2>/dev/null) || { echo "ok not-a-git-repo"; return 0; }
  runs=$(runs_dir)
  if [[ "$runs" == /* ]]; then absruns=$runs; else absruns="$cfg/$runs"; fi
  [[ -d "$absruns" ]] && absruns=$(cd -P "$absruns" && pwd)
  if [[ "$absruns" == "$root"/* ]]; then
    relruns=${absruns#"$root"/}
    relnb=$(dirname "$relruns"); [[ "$relnb" == . ]] && relnb=$relruns
  fi
  if [[ -z "$base" ]]; then
    integ=$(sed -n 's/^- integration branch:[[:space:]]*//p' "$CONFIG" 2>/dev/null | head -n 1 | tr -d '\r')
    cur=$(git -C "$root" symbolic-ref --short -q HEAD)
    if [[ -n "$integ" && "$cur" != "$integ" ]]; then
      base=$(git -C "$root" merge-base HEAD "$integ" 2>/dev/null) ||
        base=$(git -C "$root" merge-base HEAD "origin/$integ" 2>/dev/null) || base=''
    fi
    [[ -n "$base" ]] || base=$(git -C "$root" rev-parse -q --verify '@{upstream}' 2>/dev/null) || base=''
  elif ! git -C "$root" rev-parse -q --verify "$base^{commit}" >/dev/null 2>&1; then
    echo "no such ref: $base" >&2; return 2
  fi
  changed=$({
    [[ -n "$base" ]] && git -C "$root" -c core.quotePath=false diff --name-only "$base"...HEAD 2>/dev/null
    git -C "$root" -c core.quotePath=false diff --name-only HEAD 2>/dev/null
    git -C "$root" -c core.quotePath=false diff --name-only --cached 2>/dev/null   # before a first commit
    git -C "$root" -c core.quotePath=false ls-files --others --exclude-standard 2>/dev/null
  } | LC_ALL=C sort -u)
  work=$(printf '%s\n' "$changed" | awk -v nb="$relnb" 'NF && !(nb != "" && index($0, nb "/") == 1)')
  if [[ -z "$work" ]]; then
    if [[ -n "$base" ]]; then echo "ok nothing-changed"
    else echo "ok nothing-changed (uncommitted only: no base to compare commits with)"; fi
    return 0
  fi
  n=$(printf '%s\n' "$work" | wc -l | tr -d ' '); s=s; [[ $n == 1 ]] && s=''
  # is_record: a changed .md file directly in the runs folder that still exists (a deleted
  # record records nothing), not the index and not a _template
  local is_record='{ f = $0; if (r != "") { if (index(f, r) != 1) next; f = substr(f, length(r) + 1) }
                     if (f ~ /\.md$/ && f !~ /\// && f != "README.md" && f !~ /^_/ && (getline x < (d "/" f)) >= 0) found = 1 }
                   END { exit !found }'
  if [[ -n "$relruns" ]]; then
    printf '%s\n' "$changed" | awk -v r="$relruns/" -v d="$absruns" "$is_record" && { echo "ok recorded"; return 0; }
  elif [[ -d "$absruns" ]]; then
    # the records live in another repository (a workspace wrapper's docs)
    git -C "$absruns" rev-parse --show-toplevel >/dev/null 2>&1 || { echo "ok records-outside-git"; return 0; }
    { git -C "$absruns" -c core.quotePath=false diff --name-only --relative HEAD -- . 2>/dev/null
      git -C "$absruns" -c core.quotePath=false ls-files --others --exclude-standard -- . 2>/dev/null
    } | awk -v r="" -v d="$absruns" "$is_record" && { echo "ok recorded"; return 0; }
    # ponytail: for committed records only commit times are compared across the two repositories
    # (a record commit newer than BASE passes); match record to commit by name if this misfires
    local rt ref
    rt=$(git -C "$absruns" log -1 --format=%ct -- . 2>/dev/null)
    ref=$(git -C "$root" log -1 --format=%ct "${base:-HEAD}" 2>/dev/null)
    [[ -n "$rt" && -n "$ref" && "$rt" -gt "$ref" ]] && { echo "ok recorded"; return 0; }
  fi
  echo "missing $n changed file$s, no run record in $runs"
  return 1
}

cmd_record_check() {
  local base='' hook=0 out rc=0 a input sid state mark root
  for a in "$@"; do [[ "$a" == --hook ]] && hook=1; done
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --base) [[ $# -ge 2 ]] || { [[ $hook == 1 ]] && return 0; die 2 "--base needs a ref"; }; base=$2; shift 2 ;;
      --hook) shift ;;
      *) [[ $hook == 1 ]] && return 0; die 2 "usage: record-check [--base REF] [--hook]" ;;
    esac
  done
  [[ $hook == 1 ]] || { record_state "$base"; return; }
  # A Stop hook must never loop or break a session: let the stop through on the second ask, when
  # grasp is not set up here, and on anything unexpected. Only exit 2 (the reminder) blocks.
  input=$(cat)
  printf '%s' "$input" | grep -q '"stop_hook_active"[[:space:]]*:[[:space:]]*true' && return 0
  [[ -f "$CONFIG" ]] || return 0
  out=$(record_state "$base" 2>/dev/null) || rc=$?
  [[ $rc == 1 ]] || return 0
  # Remind once per state, not once per turn: a session that only answers questions in a tree
  # someone else left dirty hears this one time. The mark holds a checksum of what is changed.
  # ponytail: marks are small files left in TMPDIR, one per session; the OS clears them
  sid=$(printf '%s' "$input" | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([A-Za-z0-9_-]*\)".*/\1/p' | head -n 1)
  if [[ -n "$sid" ]] && root=$(git -C "$(dirname "$CONFIG")" rev-parse --show-toplevel 2>/dev/null); then
    state=$({ git -C "$root" rev-parse HEAD; git -C "$root" diff HEAD; git -C "$root" ls-files --others --exclude-standard; } 2>/dev/null | cksum)
    mark="${TMPDIR:-/tmp}/grasp-reminded-$sid"
    [[ -f "$mark" && "$(cat "$mark" 2>/dev/null)" == "$state" ]] && return 0
    printf '%s' "$state" > "$mark" 2>/dev/null
  fi
  # the reminder carries the shape, so it still works when the block in AGENTS.md is gone
  printf 'grasp: %s.\nIf this session changed those files, write the run record now, then finish: %s/YYYY-MM-DD-short-name.md, starting "# YYYY-MM-DD: short name" and "Status: done" (or partial, blocked, failed), then one short sentence each for "- **Asked:**", "- **Changed:**", "- **Checked:**", "- **Problems:**", "- **Next:**". Only what happened; no secrets. "Run records" in AGENTS.md and /grasp record say more.\nIf this session changed nothing, finish again: this reminder does not repeat until the files change.\n' "${out#missing }" "$(runs_dir)" >&2
  return 2
}

# ---------- projects ----------

MANIFESTS="package.json pyproject.toml go.mod Cargo.toml pom.xml build.gradle build.gradle.kts Gemfile composer.json pubspec.yaml mix.exs Package.swift Dockerfile main.tf"

# cmd_projects [DIR]: sub-projects under DIR: a repository up to eight folders deep, a package up
# to three (a manifest deeper than that is a fixture or an example far more often than an app).
# ponytail: eight is a ceiling, not a design; raise -maxdepth if a real workspace nests deeper.
# A sub-project is a folder with its own
# .git (repo) or its own manifest (package). Nothing inside a nested repo is listed: that repo
# gets its own setup. DIR itself is never listed.
cmd_projects() {
  [[ $# -le 1 ]] || die 2 "usage: projects [DIR]"
  local top=${1:-.} m names=() path kind marks url
  [[ -d "$top" ]] || die 2 "no such folder: $top"
  for m in $MANIFESTS '*.csproj'; do names+=(-o -name "$m"); done
  (cd "$top" && find . -maxdepth 9 \
      \( -name node_modules -o -name vendor -o -name dist -o -name build -o -name target -o -name venv -o -name __pycache__ \) -prune \
      -o -name .git -print -prune \
      -o -name '.?*' -prune \
      -o \( -name ' ' "${names[@]}" \) -print) | sed 's|^\./||' | LC_ALL=C sort | awk '
    split($0, p, "/") < 2 { next }   # a marker in DIR itself
    { n = split($0, p, "/"); m = p[n]; d = substr($0, 1, length($0) - length(m) - 1)
      if (m != ".git" && n > 4) next   # packages: three folders deep at most
      if (d in marks) marks[d] = marks[d] "," m; else { order[++k] = d; marks[d] = m }
      if (m == ".git") repo[d] = 1 }
    END { for (i = 1; i <= k; i++) {
            d = order[i]; skip = 0; n = split(d, p, "/"); a = ""
            for (j = 1; j < n; j++) { a = (j == 1 ? p[1] : a "/" p[j]); if (a in repo) skip = 1 }
            if (!skip) printf "%s\t%s\t%s\n", d, (d in repo ? "repo" : "package"), marks[d] } }
  ' | LC_ALL=C sort | while IFS=$'\t' read -r path kind marks; do
    # a repository also shows its origin, so two checkouts of one repository can be told apart
    url=''; [[ $kind == repo ]] && url=$(git -C "$top/$path" remote get-url origin 2>/dev/null)
    printf '%s\t%s\t%s%s\n' "$path" "$kind" "$marks" "${url:+$'\t'$url}"
  done
}

# ---------- check-link ----------

urlencode() {
  local s=$1 out='' c i
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    case "$c" in
      [a-zA-Z0-9.~_-]) out+=$c ;;
      *) out+=$(printf '%%%02X' "'$c") ;;
    esac
  done
  printf '%s' "$out"
}

# json_field NAME < JSON -> decoded string value (handles \" \\ \/ \n \t \uXXXX incl. surrogates)
json_field() {
  LC_ALL=C awk -v name="$1" '
    function hexval(h,   i, v, d) { v = 0; h = tolower(h)
      for (i = 1; i <= length(h); i++) { d = index("0123456789abcdef", substr(h, i, 1)) - 1; v = v * 16 + d }
      return v }
    function utf8(cp) {
      if (cp < 128) return sprintf("%c", cp)
      if (cp < 2048) return sprintf("%c%c", 192 + int(cp / 64), 128 + cp % 64)
      if (cp < 65536) return sprintf("%c%c%c", 224 + int(cp / 4096), 128 + int(cp / 64) % 64, 128 + cp % 64)
      return sprintf("%c%c%c%c", 240 + int(cp / 262144), 128 + int(cp / 4096) % 64, 128 + int(cp / 64) % 64, 128 + cp % 64)
    }
    { buf = buf $0 "\n" }
    END {
      key = "\"" name "\""
      p = index(buf, key); if (!p) exit 1
      rest = substr(buf, p + length(key))
      sub(/^[ \t\r\n]*:[ \t\r\n]*"/, "", rest)
      out = ""; i = 1; n = length(rest)
      while (i <= n) {
        c = substr(rest, i, 1)
        if (c == "\"") break
        if (c != "\\") { out = out c; i++; continue }
        e = substr(rest, i + 1, 1)
        if (e == "u") {
          cp = hexval(substr(rest, i + 2, 4)); i += 6
          if (cp >= 55296 && cp <= 56319 && substr(rest, i, 2) == "\\u") {
            lo = hexval(substr(rest, i + 2, 4))
            if (lo >= 56320 && lo <= 57343) { cp = 65536 + (cp - 55296) * 1024 + (lo - 56320); i += 6 }
          }
          out = out utf8(cp); continue
        }
        if (e == "n") out = out " "; else if (e == "t") out = out " "
        else if (e == "b" || e == "f" || e == "r") out = out ""
        else out = out e
        i += 2
      }
      printf "%s", out
    }'
}

cmd_check_link() {
  [[ $# -eq 1 && -n "$1" ]] || die 2 "usage: check-link URL"
  local url=$1 curl=${GRASP_CURL:-curl} res rc code final body title channel
  local common=(-s --max-time 10 -A grasp-link-check)
  case "$url" in
    https://www.youtube.com/*|https://youtube.com/*|https://m.youtube.com/*|https://youtu.be/*)
      rc=0
      res=$("$curl" "${common[@]}" -w $'\n%{http_code}' \
        "https://www.youtube.com/oembed?url=$(urlencode "$url")&format=json") || rc=$?
      [[ $rc == 28 ]] && { echo "fail timeout"; return 1; }
      code=${res##*$'\n'}; body=${res%$'\n'*}
      [[ "$code" == 200 ]] || { echo "fail ${code:-000}"; return 1; }
      title=$(printf '%s' "$body" | json_field title) || { echo "fail no-title"; return 1; }
      channel=$(printf '%s' "$body" | json_field author_name)
      printf 'ok\t%s\t%s\n' "$title" "$channel"
      ;;
    *)
      # a LinkedIn Learning page is kept, to read the course title from; any other is thrown away
      local learning=0 sink=(-o /dev/null)
      case "$url" in https://www.linkedin.com/learning/*|https://linkedin.com/learning/*) learning=1; sink=() ;; esac
      rc=0
      res=$("$curl" "${common[@]}" -L ${sink[@]+"${sink[@]}"} -w $'\n%{http_code} %{url_effective}' "$url") || rc=$?
      [[ $rc == 28 ]] && { echo "fail timeout"; return 1; }
      body=${res%$'\n'*}; res=${res##*$'\n'}
      code=${res%% *}; final=${res#* }
      [[ "$code" == 200 ]] || { echo "fail ${code:-000}"; return 1; }
      [[ $learning == 1 ]] || { printf 'ok\t%s\n' "$final"; return 0; }
      case "$final" in
        https://www.linkedin.com/learning/*|https://linkedin.com/learning/*) ;;
        *) echo "fail not-learning"; return 1 ;;
      esac
      # ponytail: reads a <title> that sits on one line, which is how LinkedIn serves it
      title=$(printf '%s\n' "$body" | awk -v q="'" '
        match($0, /<title[^>]*>/) {
          t = substr($0, RSTART + RLENGTH); i = index(t, "</title>"); if (!i) next
          t = substr(t, 1, i - 1)
          i = index(t, " | LinkedIn Learning"); if (i) t = substr(t, 1, i - 1)
          sub(/ Online Class[ \t]*$/, "", t)
          gsub(/&#39;/, q, t); gsub(/&quot;/, "\"", t); gsub(/&amp;/, "\\&", t)
          gsub(/^[ \t]+|[ \t]+$/, "", t); print t; exit
        }')
      [[ -n "$title" ]] || { echo "fail no-title"; return 1; }
      printf 'ok\t%s\t%s\n' "$final" "$title"
      ;;
  esac
}

# ---------- change-map ----------

CM_MAX_BOXES=18

# cm_files TOP MB [HEAD] -> "STATUS<tab>PATH" for every file changed since MB: commits, uncommitted
# and untracked, or with HEAD only the commits up to HEAD. A rename is listed under its new path
# as M; an untracked file as A.
cm_files() {
  { git -C "$1" -c core.quotePath=false diff --name-status -M "$2" ${3:+"$3"} 2>/dev/null |
      awk -F'\t' 'NF >= 2 { s = substr($1, 1, 1); if (s == "R" || s == "C") s = "M"; print s "\t" $NF }'
    [[ -n "${3:-}" ]] || git -C "$1" -c core.quotePath=false ls-files --others --exclude-standard 2>/dev/null | awk '{ print "A\t" $0 }'
  } | LC_ALL=C sort -t "$(printf '\t')" -k2,2 -u
}

# cm_parts DEPTH < cm_files -> "P<tab>FILES<tab>ADDED<tab>PART", most files first
cm_parts() {
  awk -F'\t' -v depth="$1" '
    { n = split($2, s, "/"); if (n == 1) part = "(root)"
      else { part = s[1]; for (i = 2; i < n && i <= depth; i++) part = part "/" s[i] }
      files[part]++; if ($1 == "A") added[part]++ }
    END { for (p in files) printf "P\t%d\t%d\t%s\n", files[p], added[p] + 0, p }' |
    LC_ALL=C sort -t "$(printf '\t')" -k2,2nr -k4,4
}

# cm_kind TOP MB < cm_parts -> each line plus a KIND: new when every file in the part is added
# and the folder did not exist at MB (one added file in an old folder is a change to it)
cm_kind() {
  local p n a part
  while IFS=$'\t' read -r p n a part; do
    if [[ $n == "$a" && "$part" != "(root)" ]] && ! git -C "$1" cat-file -e "$2:$part" 2>/dev/null
    then printf '%s\t%s\t%s\t%s\tnew\n' "$p" "$n" "$a" "$part"
    else printf '%s\t%s\t%s\t%s\tchanged\n' "$p" "$n" "$a" "$part"; fi
  done
}

# cm_unchanged TOP REV FILES PARTS -> how many sibling folders of the changed parts hold no changed file
cm_unchanged() {
  local top=$1 rev=$2 files=$3 parts=$4 parent
  printf '%s\n' "$parts" | awk -F'\t' '$4 != "(root)" { p = $4; if (!sub(/\/[^\/]*$/, "", p)) p = "."; print p }' |
    LC_ALL=C sort -u | while IFS= read -r parent; do
      if [[ "$parent" == . ]]; then git -C "$top" ls-tree -d --name-only "$rev"
      else git -C "$top" -c core.quotePath=false ls-tree -d --name-only "$rev" -- "$parent/"; fi
    done | LC_ALL=C sort -u |
    awk -F'\t' 'FNR == NR { if (NF >= 2) ch[++n] = $2; next }
      { for (i = 1; i <= n; i++) if (index(ch[i], $0 "/") == 1) next; c++ }
      END { print c + 0 }' <(printf '%s\n' "$files") -
}

cmd_change_map() {
  local repos=() base='' head='' h depth=2 d i top b mb files tops=() mbs=() revs=() names=() lists=() bases=() all
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo) [[ $# -ge 2 ]] || die 2 "--repo needs a folder"; repos+=("$2"); shift 2 ;;
      --base) [[ $# -ge 2 ]] || die 2 "--base needs a ref"; base=$2; shift 2 ;;
      --head) [[ $# -ge 2 ]] || die 2 "--head needs a ref"; head=$2; shift 2 ;;
      --depth) [[ $# -ge 2 && "$2" =~ ^[1-9][0-9]*$ ]] || die 2 "--depth needs a number from 1"; depth=$2; shift 2 ;;
      *) die 2 "usage: change-map [--repo DIR]... [--base REF] [--head REF] [--depth N]" ;;
    esac
  done
  [[ ${#repos[@]} -gt 0 ]] || repos=(.)
  for d in "${repos[@]}"; do
    top=$(git -C "$d" rev-parse --show-toplevel 2>/dev/null) || die 1 "not a git repository: $d"
    b=$base
    if [[ -z "$b" ]]; then
      for b in origin/HEAD origin/develop origin/main develop main master ''; do
        git -C "$top" rev-parse -q --verify "$b^{commit}" >/dev/null 2>&1 && break
      done
      [[ -n "$b" ]] || die 1 "no base branch found in $top: pass --base REF"
    fi
    git -C "$top" rev-parse -q --verify "$b^{commit}" >/dev/null 2>&1 || die 1 "no such base in $top: $b"
    h=''
    if [[ -n "$head" ]]; then
      h=$(git -C "$top" rev-parse -q --verify "$head^{commit}" 2>/dev/null) || die 1 "no such head in $top: $head"
    fi
    mb=$(git -C "$top" merge-base "$b" "${h:-HEAD}" 2>/dev/null) || die 1 "$b and ${head:-HEAD} share no history in $top"
    files=$(cm_files "$top" "$mb" "$h")
    [[ " ${bases[*]-} " == *" $b "* ]] || bases+=("$b")
    [[ -n "$files" ]] || continue
    tops+=("$top"); mbs+=("$mb"); revs+=("${h:-HEAD}"); names+=("$(basename "$top")"); lists+=("$files")
  done
  if [[ ${#tops[@]} == 0 ]]; then all="${bases[*]}"; printf 'no changes against %s\n' "${all// /, }"; return 0; fi

  # Build the map at DEPTH; while it holds more than CM_MAX_BOXES boxes, cut one level and retry.
  local out parts u boxes reduced=0
  while :; do
    out=''; boxes=0
    for i in "${!tops[@]}"; do
      parts=$(printf '%s\n' "${lists[$i]}" | cm_parts "$depth" | cm_kind "${tops[$i]}" "${mbs[$i]}")
      u=$(cm_unchanged "${tops[$i]}" "${revs[$i]}" "${lists[$i]}" "$parts")
      boxes=$((boxes + $(printf '%s\n' "$parts" | wc -l) + (u > 0 ? 1 : 0)))
      out+="R	$((i + 1))	${names[$i]}"$'\n'"$parts"$'\n'"U	$u"$'\n'
    done
    [[ $boxes -gt $CM_MAX_BOXES && $depth -gt 1 ]] || break
    depth=$((depth - 1)); reduced=1
  done
  printf '```mermaid\nflowchart TB\n'
  [[ $reduced == 1 ]] && printf '  %%%% depth reduced to %d to stay under %d boxes\n' "$depth" "$CM_MAX_BOXES"
  printf '%s' "$out" | awk -F'\t' '
    function q(s) { gsub(/"/, "\047", s); return s }
    function plural(n, w) { return n " " w (n == 1 ? "" : "s") }
    function close_repo() { if (r == "") return; if (u > 0) { printf "    r%su[\"%s other folder%s unchanged\"]\n", r, u, (u == 1 ? "" : "s"); cls = cls "  class r" r "u same\n" } print "  end" }
    $1 == "R" { r = $2; j = 0; printf "  subgraph r%s[\"%s\"]\n", r, q($3) }
    $1 == "P" { j++; lab = q($4) " \302\267 " plural($2, "file") ($3 > 0 ? ", " $3 " new" : "")
                printf "    r%sp%d[\"%s\"]\n", r, j, lab; cls = cls "  class r" r "p" j " " $5 "\n" }
    $1 == "U" { u = $2; close_repo(); r = "" }
    END { printf "%s", cls }'
  printf '  classDef new fill:#dcfce7,stroke:#15803d\n  classDef changed fill:#fde68a,stroke:#b45309\n  classDef same fill:#f3f4f6,stroke:#9ca3af,color:#6b7280\n```\n'
  printf 'Green: new. Amber: changed. Grey: untouched. Arrows: add them by hand from the architecture.\n'
}

# ---------- snippet / snippet-check ----------

# sn_repo_name DIR -> the repository folder's basename (DIR may be a sub-folder or ".")
sn_repo_name() { local t; t=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || t=$(cd "$1" 2>/dev/null && pwd -P) || return 1; basename "$t"; }

# sn_lines DIR REV FILE A B -> lines A..B of FILE as committed at REV, never the working tree
sn_lines() { git -C "$1" show "$2:$3" | awk -v s="$4" -v e="$5" 'NR >= s && NR <= e'; }

# sn_web_base URL -> https://HOST/ORG/REPO for a GitHub or GitLab remote, else nothing
sn_web_base() {
  printf '%s\n' "$1" | sed -E -e 's#^[a-z+]+://##' -e 's#^[^@/]*@##' -e 's#^([^/:]+):#\1/#' -e 's#(\.git)?/*$##' |
    awk -F/ 'NF == 3 && ($1 == "github.com" || $1 == "gitlab.com") { print "https://" $0 }'
}

cmd_snippet() {
  local repo=. rev=HEAD pos=() top full short total body ext link name base
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo) [[ $# -ge 2 ]] || die 2 "--repo needs a folder"; repo=$2; shift 2 ;;
      --rev) [[ $# -ge 2 ]] || die 2 "--rev needs a revision"; rev=$2; shift 2 ;;
      *) pos+=("$1"); shift ;;
    esac
  done
  [[ ${#pos[@]} -eq 3 && -n "${pos[0]}" && "${pos[1]}" =~ ^[1-9][0-9]*$ && "${pos[2]}" =~ ^[1-9][0-9]*$ && ${pos[1]} -le ${pos[2]} ]] ||
    die 2 "usage: snippet [--repo DIR] [--rev REV] FILE START END   (START and END are line numbers, START <= END)"
  local file=${pos[0]} a=${pos[1]} b=${pos[2]}
  top=$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null) || die 1 "not a git repository: $repo"
  full=$(git -C "$top" rev-parse -q --verify "$rev^{commit}" 2>/dev/null) || die 1 "no such revision in $top: $rev"
  short=$(git -C "$top" rev-parse --short=7 "$full")
  [[ $(git -C "$top" cat-file -t "$full:$file" 2>/dev/null) == blob ]] || die 1 "no such file at $short in $top: $file"
  total=$(git -C "$top" show "$full:$file" | awk 'END { print NR }')
  [[ $b -le $total ]] || die 1 "$file has $total lines at $short, not $b"
  body=$(sn_lines "$top" "$full" "$file" "$a" "$b")
  name=$(basename "$top"); ext=''
  [[ "${file##*/}" == *.* ]] && ext=${file##*.}
  printf '<!-- grasp:snippet repo=%s file="%s" lines=%s-%s rev=%s -->\n' "$name" "$file" "$a" "$b" "$short"
  printf '```%s\n%s\n```\n' "$ext" "$body"
  base=$(sn_web_base "$(git -C "$top" remote get-url origin 2>/dev/null)")
  if [[ -n "$base" ]]; then
    link="$base/blob/$full/${file// /%20}#L$a-L$b"
    printf '[%s lines %s-%s at %s](%s)\n' "$file" "$a" "$b" "$short" "$link"
  fi
}

cmd_snippet_check() {
  local repos=() names=() dirs=() page='' d i n found dir rc=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo) [[ $# -ge 2 ]] || die 2 "--repo needs a folder"; repos+=("$2"); shift 2 ;;
      *) [[ -z "$page" ]] || die 2 "usage: snippet-check [--repo DIR]... PAGE"; page=$1; shift ;;
    esac
  done
  [[ -n "$page" ]] || die 2 "usage: snippet-check [--repo DIR]... PAGE"
  [[ -f "$page" ]] || die 2 "no such file: $page"
  [[ ${#repos[@]} -gt 0 ]] || repos=(.)
  for d in "${repos[@]}"; do
    n=$(sn_repo_name "$d") || die 2 "no such folder: $d"
    names+=("$n"); dirs+=("$d")
  done

  local mre='^<!-- grasp:snippet repo=([^ ]+) file="([^"]*)" lines=([0-9]+)-([0-9]+) rev=([0-9a-f]+) -->$'
  local line ln=0 infence=0 bound=0 lang body= mln=0 mrepo= mfile= ma= mb= mrev= exp
  local code=0; [[ "$page" == *-code.md ]] && code=1
  while IFS= read -r line || [[ -n "$line" ]]; do
    ln=$((ln + 1))
    if [[ $infence == 1 ]]; then
      if [[ "$line" == '```' ]]; then
        infence=0
        if [[ $bound == 1 ]]; then
          bound=0; found=-1
          for i in "${!names[@]}"; do [[ "${names[$i]}" == "$mrepo" ]] && { found=$i; break; }; done
          if [[ $found -lt 0 ]]; then
            printf '%s:%d: snippet-unknown-repo %s\n' "$page" "$mln" "$mrepo"; rc=1
          else
            dir=${dirs[$found]}
            if ! git -C "$dir" cat-file -e "$mrev^{commit}" 2>/dev/null; then
              printf '%s:%d: snippet-unreachable %s@%s\n' "$page" "$mln" "$mrepo" "$mrev"; rc=1
            else
              exp=''
              [[ $(git -C "$dir" cat-file -t "$mrev:$mfile" 2>/dev/null) == blob ]] && exp=$(sn_lines "$dir" "$mrev" "$mfile" "$ma" "$mb")
              if [[ "$exp" != "${body%$'\n'}" ]]; then
                printf '%s:%d: snippet-drift %s %s-%s\n' "$page" "$mln" "$mfile" "$ma" "$mb"; rc=1
              fi
            fi
          fi
        fi
      else
        body+="$line"$'\n'
      fi
    elif [[ "$line" == '```'* ]]; then
      infence=1; body=''; lang=${line#'```'}
      if [[ $mln -gt 0 && $((mln + 1)) -eq $ln ]]; then bound=1
      elif [[ $code == 1 && "$lang" != mermaid ]]; then
        printf '%s:%d: snippet-unmarked\n' "$page" "$ln"; rc=1
      fi
    elif [[ "$line" =~ $mre ]]; then
      mln=$ln; mrepo=${BASH_REMATCH[1]}; mfile=${BASH_REMATCH[2]}; ma=${BASH_REMATCH[3]}; mb=${BASH_REMATCH[4]}; mrev=${BASH_REMATCH[5]}
    fi
  done < "$page"
  return $rc
}

# ---------- coverage ----------

# cv_quoted PAGE... -> every string in backticks or <code>, one per line
cv_quoted() {
  { grep -ohE '`[^`]+`' "$@" | sed -e 's/^.//' -e 's/.$//'
    grep -ohE '<code>[^<]+</code>' "$@" | sed -e 's#^<code>##' -e 's#</code>$##'
  } || true
}

# cv_firstcol PAGE... -> each path in the first column of a table row, or in <li><code>..</code>
cv_firstcol() {
  awk '
    /^\|/ { s = substr($0, 2); i = index(s, "|")
            if (i) { cell = substr(s, 1, i - 1)
                     while (match(cell, /`[^`]+`/)) { print substr(cell, RSTART + 1, RLENGTH - 2); cell = substr(cell, RSTART + RLENGTH) } } }
    { t = $0; while (match(t, /<li><code>[^<]+<\/code>/)) { print substr(t, RSTART + 10, RLENGTH - 17); t = substr(t, RSTART + RLENGTH) } }' "$@"
}

# cv_range PAGE NAME -> BASE..HEAD from the page's "Checked against:" line for repository NAME
cv_range() {
  grep -m1 '^Checked against:' "$1" | grep -oE '`[^`@]+@[0-9a-f]+\.\.[0-9a-f]+`' |
    awk -v n="$2" '{ s = substr($0, 2, length($0) - 2); i = index(s, "@"); if (substr(s, 1, i - 1) == n) { print substr(s, i + 1); f = 1; exit } } END { exit !f }'
}

cmd_coverage() {
  local repos=() base='' head='' pages=() usage="usage: coverage [--repo DIR]... [--base REF] [--head REF] PAGE..."
  local d top name b h mb range f changed='' present='' pg missing stale total
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo) [[ $# -ge 2 ]] || die 2 "--repo needs a folder"; repos+=("$2"); shift 2 ;;
      --base) [[ $# -ge 2 ]] || die 2 "--base needs a ref"; base=$2; shift 2 ;;
      --head) [[ $# -ge 2 ]] || die 2 "--head needs a ref"; head=$2; shift 2 ;;
      -*) die 2 "$usage" ;;
      *) pages+=("$1"); shift ;;
    esac
  done
  [[ ${#pages[@]} -gt 0 ]] || die 2 "$usage"
  for pg in "${pages[@]}"; do [[ -f "$pg" ]] || die 2 "no such file: $pg"; done
  [[ ${#repos[@]} -gt 0 ]] || repos=(.)
  for d in "${repos[@]}"; do
    top=$(git -C "$d" rev-parse --show-toplevel 2>/dev/null) || die 2 "not a git repository: $d"
    name=$(basename "$top"); b=$base; h=$head
    if [[ -z "$b" ]]; then
      range=$(cv_range "${pages[0]}" "$name") ||
        die 2 "no range for $name: pass --base, or put \`$name@BASE..HEAD\` on a Checked against line of ${pages[0]}"
      b=${range%%..*}; [[ -n "$h" ]] || h=${range#*..}
    fi
    git -C "$top" rev-parse -q --verify "$b^{commit}" >/dev/null 2>&1 || die 2 "no such base in $top: $b"
    [[ -z "$h" ]] || git -C "$top" rev-parse -q --verify "$h^{commit}" >/dev/null 2>&1 || die 2 "no such head in $top: $h"
    mb=$(git -C "$top" merge-base "$b" "${h:-HEAD}" 2>/dev/null) || die 2 "$b and ${h:-HEAD} share no history in $top"
    if [[ -n "$h" ]]; then   # committed work only
      while IFS= read -r -d '' f; do changed+="$name"$'\t'"$f"$'\n'; done < <(git -C "$top" diff --name-only --no-renames -z "$mb" "$h")
      present+=$(git -C "$top" ls-tree -r --name-only -z "$h" | tr '\0' '\n' | awk -v n="$name" '{ print n "\t" $0 }')$'\n'
    else                     # no head: the working tree too, staged, unstaged and untracked
      while IFS= read -r -d '' f; do changed+="$name"$'\t'"$f"$'\n'; done < <(git -C "$top" diff --name-only --no-renames -z "$mb"; git -C "$top" ls-files --others --exclude-standard -z)
      present+=$(git -C "$top" ls-files --cached --others --exclude-standard -z | tr '\0' '\n' | awk -v n="$name" '{ print n "\t" $0 }')$'\n'
    fi
  done
  total=$(printf '%s' "$changed" | awk 'END { print NR }')

  # the leading blank line keeps FNR == NR from outliving an empty quoted list
  # named: the path, REPO/path, or under a `folder/**` (with or without the REPO/ in front)
  missing=$(awk -F'\t' '
    FNR == NR { if ($0 ~ /\/\*\*$/) fold[++nf] = substr($0, 1, length($0) - 2); else exact[$0] = 1; next }
    { n = $1; f = substr($0, length(n) + 2); full = n "/" f
      if ((f in exact) || (full in exact)) next
      for (i = 1; i <= nf; i++) if (index(f, fold[i]) == 1 || index(full, fold[i]) == 1) next
      print "MISSING " full }' <({ printf '\n'; cv_quoted "${pages[@]}"; }) <(printf '%s' "$changed") | sort)

  # stale: a path in a first column that is not changed and not in any repository
  stale=$(cv_firstcol "${pages[@]}" | grep -E '^[A-Za-z0-9_.@/-]+/[A-Za-z0-9_.@-]+\.[A-Za-z0-9_]+$' | sort -u |
    awk -F'\t' 'FNR == NR { if (NF >= 2) { k[$2] = 1; k[$1 "/" $2] = 1 } next } !($0 in k) { print "STALE " $0 }' \
      <(printf '%s\n%s\n' "$changed" "$present") -)

  [[ -z "$missing" ]] || printf '%s\n' "$missing"
  [[ -z "$stale" ]] || printf '%s\n' "$stale"
  local nm=0; [[ -z "$missing" ]] || nm=$(printf '%s\n' "$missing" | awk 'END { print NR }')
  printf '%d of %d changed files named\n' $((total - nm)) "$total"
  [[ -z "$missing$stale" ]]
}

# ---------- lint-page ----------

cmd_lint_page() {
  [[ $# -ge 1 ]] || die 2 "usage: lint-page FILE..."
  local f out rc=0 line file ln target
  for f in "$@"; do [[ -f "$f" ]] || die 2 "no such file: $f"; done
  out=$(mktemp "${TMPDIR:-/tmp}/grasp.XXXXXX") || die 1 "cannot create a temporary file in ${TMPDIR:-/tmp}; nothing was changed"
  awk -v form="$TOGGLE_FORM" '
    # report(rule): on this line. report(rule, n, f): on line n, of file f when given
    function report(rule, n, f) { printf "%s:%d: %s\n", (f != "" ? f : FILENAME), (n ? n : FNR), rule; bad = 1 }
    function count(s, re,   n) { n = 0; while (match(s, re)) { n++; s = substr(s, RSTART + RLENGTH) } return n }
    function remote_image(s,   t) {
      while (match(s, /!\[[^]]*\]\([^)]*\)/)) {
        t = substr(s, RSTART, RLENGTH); sub(/^!\[[^]]*\]\(/, "", t)
        if (t ~ /^(https?:|\/)/) return 1
        s = substr(s, RSTART + RLENGTH)
      }
      return (s ~ /<img[^>]*src="(https?:|\/)/)
    }
    # links(s): hand every link target on the line to the shell, which checks the file exists
    function links(s,   t) {
      while (match(s, /\]\([^)]*\)|href="[^"]*"/)) {
        t = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH)
        sub(/^\]\(/, "", t); sub(/\)$/, "", t); sub(/^href="/, "", t); sub(/"$/, "", t)
        if (t ~ /^</) { sub(/^</, "", t); sub(/>.*$/, "", t) }   # <a path with spaces> "title"
        else sub(/[ \t].*$/, "", t)                             # path "title", path (title)
        sub(/[#?].*$/, "", t)
        if (t == "" || t ~ /^[a-zA-Z][a-zA-Z0-9+.-]*:/ || t ~ /^\// || t ~ /[{}]/) continue
        gsub(/%20/, " ", t)
        printf "\001%s\t%d\t%s\n", FILENAME, FNR, t
      }
    }
    # strip(s, k, from, to): the line without what sits between from (a regex) and to, across
    # lines; k names the state. Used for <pre>...</pre>: quoted code is never Markdown, so no
    # rule below reads it. And for comments, which a reader never sees.
    function strip(s, k, from, to,   out, i, j) {
      out = ""
      while (1) {
        if (inside[k]) {
          j = index(s, to)
          if (!j) return out
          s = substr(s, j + length(to)); inside[k] = 0
        }
        i = match(s, from)
        if (!i) return out s
        out = out substr(s, 1, i - 1); s = substr(s, i + RLENGTH); inside[k] = 1
      }
    }
    # shown(s): the line as its reader sees it, for the word count. Inline code stays, less its
    # "<", so a `<pre>` named in prose opens nothing.
    function shown(s,   out, c) {
      out = ""
      while (match(s, /`[^`]*`/)) {
        c = substr(s, RSTART + 1, RLENGTH - 2); gsub(/</, " ", c)
        out = out substr(s, 1, RSTART - 1) " " c " "; s = substr(s, RSTART + RLENGTH)
      }
      return out s
    }
    # words(s): the tokens that hold a letter or a digit, so table pipes, rules, bullets and
    # heading marks are not words. A link or an image counts its text, never its target.
    # ponytail: ASCII letters and digits only (this runs in the C locale), so a word written
    # wholly in another script is not counted; count bytes above 127 too if pages need it.
    function words(s,   n, i, w, tok) {
      gsub(/\]\([^)]*\)/, "]", s)
      n = split(s, tok); w = 0
      for (i = 1; i <= n; i++) if (tok[i] ~ /[A-Za-z0-9]/) w++
      return w
    }
    # boxes(t): the boxes one line of a diagram adds.
    # ponytail: a heuristic, not a Mermaid parser. In a flowchart an id counts once, where it is
    # given a shape with a label (id["x"], id(x), id{x}); a bare id that is never given a label
    # is not counted, and a subgraph never is. In a sequence diagram, participant and actor
    # lines count; one that only appears in a message does not. Parse Mermaid if this misleads.
    function boxes(t,   n, id, c, j) {
      if (mtype == "sequenceDiagram") return (t ~ /^(create[ \t]+)?(participant|actor)[ \t]/)
      if (mtype != "flowchart" && mtype != "graph") return 0
      if (t ~ /^(subgraph|style|classDef|linkStyle|class|click)([ \t]|$)/) return 0
      gsub(/"[^"]*"/, "\"\"", t); gsub(/\|[^|]*\|/, " ", t)   # the text of a label holds no ids
      n = 0
      while (match(t, /[A-Za-z0-9_]+[[({]/)) {
        id = substr(t, RSTART, RLENGTH - 1); c = substr(t, RSTART + RLENGTH - 1, 1)
        t = substr(t, RSTART + RLENGTH)
        j = index(t, (c == "[" ? "]" : (c == "(" ? ")" : "}"))); if (j) t = substr(t, j + 1)
        if (!(id in box)) { box[id] = 1; n++ }
      }
      return n
    }
    # finish(f): the checks that need the whole page. Its kind, read from its content (the first
    # that matches), sets the word limit and whether it must explain its concepts. An index or
    # a README has no kind: neither check applies.
    function finish(f,   limit, needs) {
      limit = 0; needs = 0
      # a run record: the five lines under a dated title (AGENTS.md also spells out the lines)
      isrun = (isrun && h1 ~ /^# [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]: /)
      if (isrun) limit = 150
      else if (h1 ~ /: app map[ \t]*$/) { limit = 1100; needs = 1 }     # app map
      else if (h1 ~ /: architecture[ \t]*$/) { limit = 900; needs = 1 }  # architecture page
      else if (h1 ~ /: how the projects fit[ \t]*$/) limit = 1100       # workspace map
      else if (isissue) { limit = 400; needs = 1 }                      # issue page
      else if (isfeature) { limit = 350; needs = 1 }                    # feature page
      if (limit && nwords > limit) report("too-long " nwords " words, limit " limit, 1, f)
      if (needs && !concepts) report("no-concepts", 1, f)
      if (h1 ~ /: architecture[ \t]*$/ && !isrun && !lessons) report("no-lessons", 1, f)
      # the explain-back is the step that makes the change understood: a page is not built without it
      if (isissue && !isrun && isdone && noanswer) report("no-answer", noanswer, f)
    }
    FNR == 1 {
      if (NR > 1) finish(page)
      page = FILENAME; fence = ""; depth = 0; split("", inside); mm = 0; prev = "blank"; wrapped = 0
      nwords = isrun = isissue = isfeature = concepts = isdone = noanswer = inlessons = lessons = 0; h1 = ""
    }
    {
      line = $0; sub(/\r$/, "", line)
      t = line; sub(/^(>[ ]?)*[ ]{0,3}/, "", t)
      # fenced code: skip everything inside, matching the opening fence character
      if (fence != "") {
        prev = "other"
        if (index(t, fence) == 1) {
          # past 20 boxes the text of a diagram is too small to read: reported where it opens
          if (mm && nbox > 20) report("too-many-boxes " nbox " boxes, limit 20", mmline)
          fence = ""; mm = 0; next
        }
        sub(/^[ \t]+/, "", t)
        if (mm && t != "" && t !~ /^%%/) {
          # only the diagram types the pages use and that were render-tested
          if (mm == 1) {
            mm = 2; mtype = t; sub(/[ \t].*$/, "", mtype)
            if (t !~ /^(flowchart|graph|sequenceDiagram|erDiagram|classDiagram)([ \t]|$)/) report("mermaid-type")
          }
          if (count(t, "\"") % 2) report("mermaid-quote")
          nbox += boxes(t)
        }
        next
      }
      if (t ~ /^```/ || t ~ /^~~~/) {
        fence = substr(t, 1, 3)
        mm = (t ~ /^(```+|~~~+)[ \t]*mermaid[ \t]*$/)
        mmline = FNR; nbox = 0; split("", box)
        if (depth > 0) report("details-markdown")
        next
      }
      # the marks finish() reads the kind of page from
      if (line ~ /^- \*\*Asked:\*\*/) isrun = 1
      if (h1 == "" && line ~ /^# /) h1 = line
      if (line ~ /^Status: (planned|building|built|verified|blocked)/) isissue = 1
      if (line ~ /^Status: (built|verified)/) isdone = 1
      if (line ~ /Your answer:[ \t]*$/ && !noanswer) noanswer = FNR
      if (index(line, "part of the [app map](")) isfeature = 1
      if (line == "## Concepts") concepts = 1
      if (line ~ /^## /) inlessons = (line == "## Lessons")
      if (inlessons && line ~ /https:\/\/((www\.|m\.)?youtube\.com|youtu\.be|www\.linkedin\.com\/learning)\/|No checked lesson yet/) lessons = 1
      # ignore inline code first (a `<pre>` named in prose opens nothing), then quoted code
      code = line; gsub(/`[^`]*`/, "", code); code = strip(code, "pre", "<pre[ >]", "</pre>"); gsub(/<code>[^<]*<\/code>/, "", code)
      links(code)
      opens = count(code, "<details[ >]"); closes = count(code, "</details>")
      start = depth
      # the words a reader sees: not code fences (skipped above), toggles, <pre> or comments
      if (start == 0 && opens == 0) nwords += words(strip(strip(shown(line), "shown-pre", "<pre[ >]", "</pre>"), "comment", "<!--", "-->"))
      if (code ~ /<details[^>]*[ \t]open([ \t=>]|$)/) report("details-open")
      if (start == 0 && opens > 0) {   # the opening line: its summary is inside the HTML block too
        bt = substr(line, index(line, "<details")); gsub(/<code>[^<]*<\/code>/, "", bt)
        if (bt ~ /`[^`]+`/) report("details-markdown")
      }
      if (start > 0 && opens > 0) report("details-nested")
      else if (start > 0 && line !~ /^[ \t]*<\/details>[ \t]*$/) {
        if (line ~ /^[ \t]*$/) report("details-blank-line")
        else if (code ~ /\[!(WARNING|CAUTION)\]/) report("warning-in-toggle")
        else {
          m = code; sub(/^[ \t]+/, "", m)
          # backticks outside <pre> and <code>: Obsidian shows them as typed inside an HTML block
          bt = strip(line, "bt-pre", "<pre[ >]", "</pre>"); gsub(/<code>[^<]*<\/code>/, "", bt)
          if (m ~ /^(#|[-*+] |[0-9]+\. |\||>|!\[)/ || code ~ /\[[^]]*\]\([^)]*\)/ || code ~ /\*\*[^*]+\*\*/ || bt ~ /`[^`]+`/)
            report("details-markdown")
        }
      }
      if (code ~ /\[\[[^]]+\]\]/) report("wikilink")
      if (form == "html" && t ~ /^\[![A-Za-z]+\][-+]/ && line ~ /^>/) report("foldable-callout")
      if (code ~ /==[^= ]([^=]*[^= ])?==/) report("highlight")
      if (remote_image(code)) report("remote-image")
      # hard-wrap: Obsidian shows every newline inside a paragraph or list item as a line
      # break, so prose wrapped at a fixed width reads as ragged short lines. One paragraph, one line.
      # ponytail: a heuristic. A wrap is a prose line right under a prose or list line of 60 or
      # more characters; a line that opens with a bold label is a deliberate new line.
      k = line; ind = match(k, /[^ \t]/) - 1; sub(/^[ \t]+/, "", k)
      if (start > 0 || depth + opens > 0) kind = "other"
      else if (k == "") kind = "blank"
      else if (k ~ /^(#|\||>|<|!\[)/ || k ~ /^(---+|\*\*\*+)[ \t]*$/) kind = "other"
      else if (k ~ /^([-*+]|[0-9]+\.)[ \t]/) kind = "list"
      else if (ind >= 4 && prev != "list" && prev != "para") kind = "other"   # an indented code block
      else kind = "para"
      if (kind == "para" && (prev == "para" || prev == "list")) {
        if (!wrapped && prevlen >= 60 && k !~ /^\*\*/) { report("hard-wrap"); wrapped = 1 }
        kind = prev
      } else wrapped = 0
      prev = kind; prevlen = length(line)
      depth += opens - closes; if (depth < 0) depth = 0
    }
    END { if (NR) finish(page); exit bad }
  ' "$@" > "$out" || rc=$?
  while IFS= read -r line; do
    if [[ "$line" == $'\001'* ]]; then
      IFS=$'\t' read -r file ln target <<< "${line#?}"
      [[ -e "$(dirname "$file")/$target" ]] && continue
      printf '%s:%s: dead-link %s\n' "$file" "$ln" "$target"; rc=1
    else
      printf '%s\n' "$line"
    fi
  done < "$out"
  rm -f "$out"
  # a page under a git-ignored folder is never committed, and nothing else would say so
  for f in "$@"; do
    if git -C "$(dirname "$f")" check-ignore -q "$(basename "$f")" 2>/dev/null; then
      printf '%s:1: git-ignored\n' "$f"; rc=1
    fi
  done
  return $rc
}

CONFIG=./.grasp.md
while [[ $# -gt 0 ]]; do
  case "$1" in
    --config) [[ $# -ge 2 ]] || die 2 "--config needs a path"; CONFIG=$2; shift 2 ;;
    *) break ;;
  esac
done

cmd=${1:-}
[[ $# -gt 0 ]] && shift
case "$cmd" in
  -h|--help|help) usage ;;
  version) cmd_version ;;
  connect|disconnect|block|status|refresh|projects) "cmd_$cmd" "$@" ;;
  record-index) cmd_record_index "$@" ;;
  record-check) cmd_record_check "$@" ;;
  check-link) cmd_check_link "$@" ;;
  lint-page) cmd_lint_page "$@" ;;
  change-map) cmd_change_map "$@" ;;
  snippet) cmd_snippet "$@" ;;
  snippet-check) cmd_snippet_check "$@" ;;
  coverage) cmd_coverage "$@" ;;
  "") usage >&2; exit 2 ;;
  *) usage >&2; printf '\ngrasp-tools: unknown command: %s\n' "$cmd" >&2; exit 2 ;;
esac
